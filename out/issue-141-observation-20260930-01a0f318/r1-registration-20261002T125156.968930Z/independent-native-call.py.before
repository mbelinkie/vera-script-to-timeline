"""Single audited independent action; never retries or handles Copy/Paste."""

import ast
import hashlib
import importlib.util
import json
import subprocess
import sys
import time
from datetime import UTC, datetime
from pathlib import Path

OUT = Path(__file__).resolve().parent
ROOT = OUT.parents[1]
HERE = ROOT / "docs/investigations/issue-141"
PLUGINS = Path("/Library/Application Support/Blackmagic Design/DaVinci Resolve/Workflow Integration Plugins")
CONFIG = PLUGINS / "vera-issue-141-observation.json"
HS = "/Applications/Hammerspoon.app/Contents/Frameworks/hs/hs"
HASHES = {
    "hammerspoon-launch.lua": "f92cc1b6e5bd7e0611bf94aa9a7262f3c14936de03fc5072e1c0100593cd461d",
    "hammerspoon-editorial.lua": "47b6ec354c00e3ef1296a70c29e8846e1661fef692177d90bc96f27ba5b6bc6d",
}
ACTIONS = {
    "editorial-readback", "editorial-case-prepare", "editorial-case-restore",
    "editorial-case-review-preparation",
    "av-output-queue-from-fresh-checkpoint",
    "av-output-drop-unstarted-owned-job",
    "av-output-full-matrix", "av-output-full-matrix-queue-only",
    "av-output-full-matrix-continue",
    "audio-mapping-mute",
    "render-outer-recovery",
    "r2-linked-second-position", "r2-linked-interval-delete",
    "r2-named-split-ready", "r2-named-split-review",
    "r3-boundary-a3-prepare", "r3-boundary-a3-split-ready", "r3-boundary-a3-split-review",
    "r1-repeat-reopen", "r1-repeat-duplicate",
}
IMMUTABLE = {"projectName", "externalScriptingSetting", "mediaDir", "outputDir", "manifestSha256", "probePath", "probeSha256"}
DISPATCH_MODULES = {
    "r1-repeat-reopen": ("r1-repeat-six.py", "4aece3d8ab7c7e0ab215fc9eb841fc95b56b85fb0809859e7f587ce83b0e2c28"),
    "r1-repeat-duplicate": ("r1-repeat-six.py", "4aece3d8ab7c7e0ab215fc9eb841fc95b56b85fb0809859e7f587ce83b0e2c28"),
    "editorial-readback": (
        "editorial-readback.py",
        "d9df76229ead502b2d9ff31a1847eb9b858aa8931d25d279b560244e93690354",
    ),
}


CASE_EVIDENCE_KEYS = (
    "preparationResult", "preparationResultSha256", "firstSplitPair",
    "firstSplitPairSha256", "secondSplitPair", "secondSplitPairSha256",
    "secondPositionResult", "secondPositionResultSha256", "selectionResult",
    "selectionResultSha256", "firstSelectionResult", "firstSelectionResultSha256",
    "postEditPair", "postEditPairSha256", "partialResult", "partialResultSha256",
    "residualResumeRecord", "residualResumeRecordSha256",
)


def stage_updates(config, updates):
    staged = dict(config)
    if updates["action"] == "av-output-full-matrix-continue":
        staged["resumeExistingJob"] = updates.get("resumeExistingJob", False)
    if updates["action"] == "editorial-case-prepare":
        staged.update({key: None for key in CASE_EVIDENCE_KEYS})
    staged.update(updates, timelineInventory="protected-six")
    return staged


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def assert_dispatch_module(action):
    if action not in DISPATCH_MODULES:
        return
    filename, expected = DISPATCH_MODULES[action]
    # Compare against the actual dispatcher table, not just another copied pin.
    tree = ast.parse((HERE / "probe.py").read_text())
    tables = [ast.literal_eval(node.value) for node in ast.walk(tree)
              if isinstance(node, ast.Assign)
              and any(isinstance(t, ast.Name) and t.id == "owned_modules"
                      for t in node.targets)]
    if len(tables) != 1 or tables[0].get(action) != (filename, expected):
        raise RuntimeError("Dispatcher-owned module pin disagrees: " + action)
    path = HERE / filename
    actual = None if path.is_symlink() or not path.is_file() else sha(path)
    if actual != expected:
        raise RuntimeError(
            f"Pinned dispatcher module changed: {filename} "
            f"(expected {expected}, got {actual})"
        )


def validate(updates, menu):
    if menu is not None:
        assert updates is None and menu in {"edit-page", "step-forward", "timeline-start", "save-project", "focus-timeline", "auto-none", "auto-v1", "auto-a1", "auto-a3", "deselect", "select", "split", "nudge-right"}
    else:
        assert isinstance(updates, dict) and updates.get("action") in ACTIONS
        assert not IMMUTABLE.intersection(updates)
        if updates["action"] == "editorial-readback":
            assert_dispatch_module("editorial-readback")
            path = HERE / "editorial-readback.py"
            spec = importlib.util.spec_from_file_location("approved_readback_labels", path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            assert updates.get("editorialReadbackLabel") in module.LABELS, "Unapproved editorial readback label"
        if updates["action"] in {"r1-repeat-reopen", "r1-repeat-duplicate"}:
            assert updates.get("case") == 'R1-repeat-six'
        elif updates["action"] != "editorial-readback":
            assert updates.get("case", "").startswith(("R2-", "R3-"))


def invoke(updates=None, menu=None):
    validate(updates, menu)
    config = json.loads(CONFIG.read_text())
    assert config["action"] == "observe" and config["externalScriptingSetting"] == "None"
    assert config.get("timelineInventory") == "protected-six"
    assert config["projectName"] == "VERA Issue 141 Synthetic Probe 20260930-01a0f318"
    assert Path(config["outputDir"]).resolve() == OUT
    assert Path(config["probePath"]) == HERE / "probe.py"
    assert config["probeSha256"] == sha(HERE / "probe.py")
    # Every native/menu dispatch shares this readback dependency; check it first.
    assert_dispatch_module("editorial-readback")
    filename = "hammerspoon-launch.lua" if menu is None else "hammerspoon-editorial.lua"
    macro = HERE / filename
    assert not macro.is_symlink() and sha(macro) == HASHES[filename]
    prior = set(PLUGINS.glob("vera-issue-141-observation-result-*.json"))
    directory = OUT / datetime.now(UTC).strftime("independent-action-%Y%m%dT%H%M%S.%fZ")
    directory.mkdir()
    (directory / "previous-config.json").write_text(json.dumps(config, indent=2) + "\n")
    if updates is not None:
        config = stage_updates(config, updates)
        (directory / "staged-config.json").write_text(json.dumps(config, indent=2) + "\n")
        CONFIG.write_text(json.dumps(config, indent=2) + "\n")
    lua = "return dofile(" + json.dumps(str(macro)) + ").run("
    lua += "" if menu is None else json.dumps(menu)
    lua += ")"
    returned = subprocess.run([HS, "-c", lua], capture_output=True, text=True, timeout=10)
    (directory / "launch.json").write_text(json.dumps({"menu": menu, "sourceSha256": sha(macro), "exitCode": returned.returncode, "stdout": returned.stdout, "stderr": returned.stderr}, indent=2) + "\n")
    if returned.returncode != 0:
        # Disarm only the staged local configuration. No Resolve retry/cleanup.
        live = json.loads(CONFIG.read_text())
        live.update(action="observe", stage="baseline-repeat")
        CONFIG.write_text(json.dumps(live, indent=2) + "\n")
        raise RuntimeError("Menu refused; evidence at " + str(directory / "launch.json"))
    if menu is not None:
        return {"auditDirectory": str(directory), "menu": menu, "dispatched": True}
    deadline = time.monotonic() + 180
    while time.monotonic() < deadline:
        fresh = set(PLUGINS.glob("vera-issue-141-observation-result-*.json")) - prior
        if fresh:
            assert len(fresh) == 1, "Multiple native results; stop"
            path = fresh.pop()
            try:
                result = json.loads(path.read_text())
            except json.JSONDecodeError:
                time.sleep(.2)
                continue
            (directory / "result-reference.json").write_text(json.dumps({"path": str(path), "sha256": sha(path)}, indent=2) + "\n")
            return {**result, "_nativeResultPath": str(path), "_auditDirectory": str(directory)}
        time.sleep(.2)
    raise RuntimeError("Native result pending; do not relaunch; evidence at " + str(directory))


def demo():
    for filename, digest in HASHES.items():
        path = HERE / filename
        assert not path.is_symlink() and sha(path) == digest, "Unreviewed macro source: " + filename
    validate({"action": "editorial-readback", "editorialReadbackLabel": "editorial-context"}, None)
    try:
        validate({"action": "editorial-readback", "editorialReadbackLabel": "r2-residual-resume-preflight"}, None)
    except AssertionError:
        pass
    else:
        raise AssertionError("Unapproved readback label accepted before launch")
    validate({"action": "editorial-case-prepare", "case": "R2-linked"}, None)
    validate({"action": "r1-repeat-reopen", "case": 'R1-repeat-six'}, None)
    validate({"action": "r1-repeat-duplicate", "case": 'R1-repeat-six'}, None)
    assert_dispatch_module("r1-repeat-reopen")
    assert_dispatch_module("r1-repeat-duplicate")
    original_pin = DISPATCH_MODULES["editorial-readback"]
    DISPATCH_MODULES["editorial-readback"] = (original_pin[0], "0" * 64)
    try:
        try:
            assert_dispatch_module("editorial-readback")
        except RuntimeError as error:
            assert "Dispatcher-owned module pin disagrees" in str(error)
        else:
            raise AssertionError("Wrong dispatcher module pin accepted")
    finally:
        DISPATCH_MODULES["editorial-readback"] = original_pin
    for updates, menu in [({"action": "prepare"}, None), ({"action": "r1-repeat-duplicate", "case": "R1-copy"}, None), ({"action": "editorial-case-prepare", "case": "R1-copy"}, None), ({"action": "editorial-readback", "externalScriptingSetting": "Local"}, None), (None, "paste")]:
        try:
            validate(updates, menu)
        except AssertionError:
            pass
        else:
            raise AssertionError("Unapproved action accepted")
    stale = {"secondPositionResult": "previous-R2.json", "secondPositionResultSha256": "old", "projectName": "preserved", "residualResumeRecord": "old-resume.json", "residualResumeRecordSha256": "old"}
    fresh = stage_updates(stale, {"action": "editorial-case-prepare", "case": "R3-Graphic"})
    assert fresh["secondPositionResult"] is None and fresh["projectName"] == "preserved"
    assert fresh["residualResumeRecord"] is None and fresh["residualResumeRecordSha256"] is None
    resume = stage_updates(stale, {"action": "editorial-case-prepare", "case": "R2-residual", "residualResumeRecord": "current.json", "residualResumeRecordSha256": "current"})
    assert resume["residualResumeRecord"] == "current.json" and resume["residualResumeRecordSha256"] == "current"
    assert stale["secondPositionResult"] == "previous-R2.json"
    scoped = stage_updates(stale, {"action": "editorial-case-restore", "case": "R2-partial"})
    assert scoped["secondPositionResult"] == "previous-R2.json"
    assert stage_updates({"resumeExistingJob": True}, {"action": "av-output-full-matrix-continue"})["resumeExistingJob"] is False
    assert stage_updates({}, {"action": "av-output-full-matrix-continue", "resumeExistingJob": True})["resumeExistingJob"] is True
    assert_dispatch_module("editorial-readback")
    print("Independent action and dispatcher pin guards pass; no native action.")


if __name__ == "__main__":
    assert sys.argv[1:] == ["--check"]
    demo()
