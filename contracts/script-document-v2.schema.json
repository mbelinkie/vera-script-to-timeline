{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vera.video/contracts/script-document-v2.schema.json",
  "title": "ScriptDocumentV2",
  "description": "Editor-independent ScriptDocument with structural primary visuals and independent overlay timing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "title",
    "activeDraft",
    "ideaOutline",
    "extras",
    "liveHeadSequence",
    "liveStateVector",
    "liveContentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "script-document/v2"
    },
    "id": {
      "$ref": "#/$defs/EntityId"
    },
    "projectId": {
      "$ref": "#/$defs/EntityId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scriptSettings": {
      "$ref": "#/$defs/ScriptSettings"
    },
    "activeDraft": {
      "$ref": "#/$defs/ActiveDraft"
    },
    "ideaOutline": {
      "description": "Reserved document surface; it remains empty until its owning contract is introduced.",
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "extras": {
      "description": "Reserved document surface; it remains empty until its owning contract is introduced.",
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "liveHeadSequence": {
      "$ref": "#/$defs/NonNegativeSafeInteger"
    },
    "liveStateVector": {
      "description": "Base64-encoded acknowledged collaborative state-vector evidence; it may be empty before collaboration exists.",
      "type": "string",
      "contentEncoding": "base64"
    },
    "liveContentHash": {
      "$ref": "#/$defs/ContentHash"
    }
  },
  "$defs": {
    "EntityId": {
      "type": "string",
      "format": "uuid"
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "NonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "EntityVersion": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ScriptSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presenterStillOverride": {
          "$ref": "#/$defs/PresenterStillReference"
        }
      }
    },
    "PresenterStillReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaReferenceId",
        "artifactId",
        "artifactVersion",
        "contentHash",
        "projectRelativeLocator",
        "width",
        "height",
        "provenance"
      ],
      "properties": {
        "mediaReferenceId": {
          "$ref": "#/$defs/EntityId"
        },
        "artifactId": {
          "$ref": "#/$defs/EntityId"
        },
        "artifactVersion": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "contentHash": {
          "$ref": "#/$defs/ContentHash"
        },
        "projectRelativeLocator": {
          "$ref": "#/$defs/ProjectRelativePath"
        },
        "width": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "height": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "#/$defs/LocalImportProvenance"
            },
            {
              "$ref": "#/$defs/CapturedFrameProvenance"
            }
          ]
        }
      }
    },
    "ProjectRelativePath": {
      "description": "Canonical slash-separated project-relative locator; absolute paths and dot segments are not accepted.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\\\r\\n]+$"
    },
    "LocalImportProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "originalFilename"
      ],
      "properties": {
        "origin": {
          "const": "local_import"
        },
        "originalFilename": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CapturedFrameProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "sourceMediaReferenceId",
        "sourceFrame"
      ],
      "properties": {
        "origin": {
          "const": "captured_frame"
        },
        "sourceMediaReferenceId": {
          "$ref": "#/$defs/EntityId"
        },
        "sourceFrame": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        }
      }
    },
    "ActiveDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks",
        "supportingItems"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftBlock"
          }
        },
        "supportingItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SupportingItemV2"
          }
        }
      }
    },
    "DraftBlock": {
      "oneOf": [
        {
          "$ref": "#/$defs/SectionBlock"
        },
        {
          "$ref": "#/$defs/NarrationBlockV2"
        },
        {
          "$ref": "#/$defs/DirectionBlock"
        },
        {
          "$ref": "#/$defs/VisualOnlyBlockV2"
        },
        {
          "$ref": "#/$defs/NoteDraftBlock"
        }
      ]
    },
    "SectionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "orderKey",
        "title",
        "version"
      ],
      "properties": {
        "type": {
          "const": "section"
        },
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "orderKey": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/EntityVersion"
        }
      }
    },
    "NarrationToken": {
      "description": "Stable spoken-token identity plus UTF-16 offsets into NarrationBlockV2.text; text and offset agreement remains semantic validation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "startOffset",
        "endOffset"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "startOffset": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        },
        "endOffset": {
          "$ref": "#/$defs/PositiveSafeInteger"
        }
      }
    },
    "TextAnchorRange": {
      "description": "Exact authored text range. Token existence, order and quoted-text agreement remain semantic validation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockId",
        "startTokenId",
        "endTokenId",
        "startAffinity",
        "endAffinity",
        "quotedText",
        "anchorVersion"
      ],
      "properties": {
        "blockId": {
          "$ref": "#/$defs/EntityId"
        },
        "startTokenId": {
          "$ref": "#/$defs/EntityId"
        },
        "endTokenId": {
          "$ref": "#/$defs/EntityId"
        },
        "startAffinity": {
          "$ref": "#/$defs/AnchorAffinity"
        },
        "endAffinity": {
          "$ref": "#/$defs/AnchorAffinity"
        },
        "quotedText": {
          "type": "string",
          "minLength": 1
        },
        "anchorVersion": {
          "$ref": "#/$defs/EntityVersion"
        }
      }
    },
    "AnchorAffinity": {
      "type": "string",
      "enum": [
        "before",
        "after"
      ]
    },
    "NarrationAnnotation": {
      "description": "Typed, exact-range pronunciation or performance metadata. It is never spoken narration or provider syntax.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "range",
        "value",
        "includeInPrompter",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "pronunciation_alias",
            "pronunciation_phoneme",
            "performance_note"
          ]
        },
        "range": {
          "$ref": "#/$defs/TextAnchorRange"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "includeInPrompter": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/EntityVersion"
        }
      }
    },
    "PerformanceBeat": {
      "description": "Stable recording-take identity over an exact narration token range.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "range",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "range": {
          "$ref": "#/$defs/TextAnchorRange"
        },
        "version": {
          "$ref": "#/$defs/EntityVersion"
        }
      }
    },
    "WordInpointAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockId",
        "tokenId",
        "affinity",
        "quotedWord",
        "anchorVersion"
      ],
      "properties": {
        "blockId": {
          "$ref": "#/$defs/EntityId"
        },
        "tokenId": {
          "$ref": "#/$defs/EntityId"
        },
        "affinity": {
          "const": "before"
        },
        "quotedWord": {
          "type": "string",
          "minLength": 1
        },
        "anchorVersion": {
          "$ref": "#/$defs/EntityVersion"
        }
      }
    },
    "PointAnchor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "anchor"
          ],
          "properties": {
            "kind": {
              "const": "word"
            },
            "anchor": {
              "$ref": "#/$defs/WordInpointAnchor"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "beforeBlockId",
            "afterBlockId"
          ],
          "properties": {
            "kind": {
              "const": "between_blocks"
            },
            "beforeBlockId": {
              "$ref": "#/$defs/EntityId"
            },
            "afterBlockId": {
              "$ref": "#/$defs/EntityId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "eventId",
            "edge"
          ],
          "properties": {
            "kind": {
              "const": "event_edge"
            },
            "eventId": {
              "$ref": "#/$defs/EntityId"
            },
            "edge": {
              "type": "string",
              "enum": [
                "start",
                "end"
              ]
            }
          }
        }
      ]
    },
    "BoundaryBefore": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "row_start"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "anchor"
          ],
          "properties": {
            "kind": {
              "const": "spoken_word"
            },
            "anchor": {
              "$ref": "#/$defs/WordInpointAnchor"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "controllingSlotId"
          ],
          "properties": {
            "kind": {
              "const": "previous_media_end"
            },
            "controllingSlotId": {
              "$ref": "#/$defs/EntityId"
            }
          }
        }
      ]
    },
    "SourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceInFrame"
      ],
      "properties": {
        "sourceInFrame": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        }
      }
    },
    "SourceReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/MediaReferenceSource"
        },
        {
          "$ref": "#/$defs/CaptureRevisionSource"
        },
        {
          "$ref": "#/$defs/GraphicRevisionSource"
        },
        {
          "$ref": "#/$defs/UnresolvedVisualSource"
        },
        {
          "$ref": "#/$defs/IntentionalPlaceholderSource"
        },
        {
          "$ref": "#/$defs/UrlSource"
        }
      ]
    },
    "MediaReferenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mediaReferenceId"
      ],
      "properties": {
        "kind": {
          "const": "media_reference"
        },
        "mediaReferenceId": {
          "$ref": "#/$defs/EntityId"
        }
      }
    },
    "CaptureRevisionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "captureId",
        "revisionId"
      ],
      "properties": {
        "kind": {
          "const": "capture_revision"
        },
        "captureId": {
          "$ref": "#/$defs/EntityId"
        },
        "revisionId": {
          "$ref": "#/$defs/EntityId"
        }
      }
    },
    "GraphicRevisionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "graphicId",
        "revisionId"
      ],
      "properties": {
        "kind": {
          "const": "graphic_revision"
        },
        "graphicId": {
          "$ref": "#/$defs/EntityId"
        },
        "revisionId": {
          "$ref": "#/$defs/EntityId"
        }
      }
    },
    "UnresolvedVisualSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "const": "unresolved_visual"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "IntentionalPlaceholderSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "intentional_placeholder"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "UrlSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url"
      ],
      "properties": {
        "kind": {
          "const": "url"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "NarratedVisualPayloadV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payloadId",
        "pictureKind",
        "source",
        "sourceUsage",
        "audioPolicy",
        "framingPolicy"
      ],
      "properties": {
        "kind": {
          "const": "visual"
        },
        "payloadId": {
          "$ref": "#/$defs/EntityId"
        },
        "pictureKind": {
          "type": "string",
          "enum": [
            "unresolved_visual",
            "clip",
            "image",
            "capture",
            "graphic",
            "intentional_placeholder"
          ]
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "sourceUsage": {
          "oneOf": [
            {
              "$ref": "#/$defs/SourceUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "audioPolicy": {
          "type": "string",
          "enum": [
            "mute",
            "quiet"
          ]
        },
        "framingPolicy": {
          "type": "string",
          "enum": [
            "contain",
            "cover",
            "native"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "pictureKind": {
                "const": "clip"
              }
            },
            "required": [
              "pictureKind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "media_reference"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "sourceUsage": {
                "$ref": "#/$defs/SourceUsage"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "pictureKind": {
                "const": "image"
              }
            },
            "required": [
              "pictureKind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "media_reference"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "sourceUsage": {
                "type": "null"
              },
              "audioPolicy": {
                "const": "mute"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "pictureKind": {
                "const": "capture"
              }
            },
            "required": [
              "pictureKind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "capture_revision"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "sourceUsage": {
                "type": "null"
              },
              "audioPolicy": {
                "const": "mute"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "pictureKind": {
                "const": "graphic"
              }
            },
            "required": [
              "pictureKind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "graphic_revision"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "sourceUsage": {
                "type": "null"
              },
              "audioPolicy": {
                "const": "mute"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "pictureKind": {
                "const": "unresolved_visual"
              }
            },
            "required": [
              "pictureKind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "unresolved_visual"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "sourceUsage": {
                "type": "null"
              },
              "audioPolicy": {
                "const": "mute"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "pictureKind": {
                "const": "intentional_placeholder"
              }
            },
            "required": [
              "pictureKind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "intentional_placeholder"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "sourceUsage": {
                "type": "null"
              },
              "audioPolicy": {
                "const": "mute"
              }
            }
          }
        }
      ]
    },
    "PrimaryVisualPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "presenterChoiceId"
          ],
          "properties": {
            "kind": {
              "const": "on_camera"
            },
            "presenterChoiceId": {
              "oneOf": [
                {
                  "$ref": "#/$defs/EntityId"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/NarratedVisualPayloadV2"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payloadId",
            "description"
          ],
          "properties": {
            "kind": {
              "const": "undefined"
            },
            "payloadId": {
              "$ref": "#/$defs/EntityId"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "SlotRelation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "base"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "sequential"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parentSlotId"
          ],
          "properties": {
            "kind": {
              "const": "cutaway"
            },
            "parentSlotId": {
              "$ref": "#/$defs/EntityId"
            }
          }
        }
      ]
    },
    "ContentSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "relation",
        "boundaryBefore",
        "payload",
        "playoutPolicy",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "kind": {
          "const": "content"
        },
        "relation": {
          "$ref": "#/$defs/SlotRelation"
        },
        "boundaryBefore": {
          "$ref": "#/$defs/BoundaryBefore"
        },
        "payload": {
          "$ref": "#/$defs/PrimaryVisualPayload"
        },
        "playoutPolicy": {
          "type": "string",
          "enum": [
            "match_structural_interval",
            "complete_logged_clip"
          ]
        },
        "version": {
          "$ref": "#/$defs/EntityVersion"
        }
      }
    },
    "ReturnSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "parentSlotId",
        "inpoint",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "kind": {
          "const": "return"
        },
        "parentSlotId": {
          "$ref": "#/$defs/EntityId"
        },
        "inpoint": {
          "oneOf": [
            {
              "$ref": "#/$defs/WordInpointAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
