{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vera.video/contracts/compiler-dependencies-v1.schema.json",
  "title": "CompilerDependenciesV1",
  "description": "Verified build dependencies consumed by the pure Slice 1.3 compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "build",
    "tracks",
    "roles",
    "narration",
    "resolvedVisuals"
  ],
  "properties": {
    "schemaVersion": {
      "const": "compiler-dependencies/v1"
    },
    "build": {
      "$ref": "#/$defs/BuildContext"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "timeline-manifest-v1.schema.json#/$defs/Track"
      }
    },
    "roles": {
      "$ref": "#/$defs/TrackRoles"
    },
    "narration": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NarrationDependency"
      }
    },
    "resolvedVisuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResolvedVisualDependency"
      }
    }
  },
  "$defs": {
    "BuildContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildId",
        "manifestId",
        "reportId",
        "buildClass",
        "timeline"
      ],
      "properties": {
        "buildId": {
          "$ref": "script-document-v1.schema.json#/$defs/EntityId"
        },
        "manifestId": {
          "$ref": "script-document-v1.schema.json#/$defs/EntityId"
        },
        "reportId": {
          "$ref": "script-document-v1.schema.json#/$defs/EntityId"
        },
        "buildClass": {
          "type": "string",
          "enum": [
            "preview",
            "release"
          ]
        },
        "timeline": {
          "$ref": "#/$defs/CompilerTimelineSettings"
        }
      }
    },
    "CompilerTimelineSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameRate",
        "width",
        "height",
        "audioSampleRate",
        "startFrame"
      ],
      "properties": {
        "frameRate": {
          "$ref": "timeline-manifest-v1.schema.json#/$defs/TimelineFrameRate"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "audioSampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "TrackRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presenterTrackId",
        "placeholderTrackId",
        "narrationTrackId",
        "sourceAudioTrackId"
      ],
      "properties": {
        "presenterTrackId": {
          "$ref": "timeline-manifest-v1.schema.json#/$defs/TrackId"
        },
        "placeholderTrackId": {
          "$ref": "timeline-manifest-v1.schema.json#/$defs/TrackId"
        },
        "narrationTrackId": {
          "$ref": "timeline-manifest-v1.schema.json#/$defs/TrackId"
        },
        "sourceAudioTrackId": {
          "$ref": "timeline-manifest-v1.schema.json#/$defs/TrackId"
        }
      }
    },
    "NarrationDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockId",
        "blockRevision",
        "assetId",
        "status",
        "textHash",
        "audioHash",
        "audio",
        "timing"
      ],
      "properties": {
        "blockId": {
          "$ref": "script-document-v1.schema.json#/$defs/EntityId"
        },
        "blockRevision": {
          "$ref": "script-document-v1.schema.json#/$defs/EntityVersion"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "failed"
          ]
        },
        "textHash": {
          "$ref": "script-document-v1.schema.json#/$defs/ContentHash"
        },
        "audioHash": {
          "$ref": "script-document-v1.schema.json#/$defs/ContentHash"
        },
        "audio": {
          "$ref": "#/$defs/NarrationAudio"
        },
        "timing": {
          "$ref": "#/$defs/NarrationTiming"
        },
        "failureReason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "failureReason": {}
            },
            "required": [
              "failureReason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "failureReason"
              ]
            }
          }
        }
      ]
    },
    "NarrationAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "durationSamples",
        "sampleRate",
        "channels"
      ],
      "properties": {
        "locator": {
          "$ref": "timeline-manifest-v1.schema.json#/$defs/ProjectRelativePath"
        },
        "durationSamples": {
          "type": "integer",
          "minimum": 1
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "NarrationTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordVersion",
        "contentHash",
        "alignmentVersion",
        "precision",
        "marks"
      ],
      "properties": {
        "recordVersion": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "$ref": "script-document-v1.schema.json#/$defs/ContentHash"
        },
        "alignmentVersion": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "type": "string",
          "enum": [
            "word_start_with_derived_end",
            "sentence_start",
            "none"
          ]
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimingMark"
          }
        }
      }
    },
    "TimingMark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "timeMs",
        "startUtf16",
        "endUtf16",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "word",
            "sentence"
          ]
        },
        "timeMs": {
          "type": "integer",
          "minimum": 0
        },
        "startUtf16": {
          "type": "integer",
          "minimum": 0
        },
        "endUtf16": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ResolvedVisualDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaReferenceId",
        "source"
      ],
      "properties": {
        "mediaReferenceId": {
          "$ref": "script-document-v1.schema.json#/$defs/EntityId"
        },
        "source": {
          "$ref": "#/$defs/ResolvedVisualSource"
        },
        "sourceStartFrame": {
          "type": "integer",
          "minimum": 0
        },
        "sourceAudio": {
          "$ref": "#/$defs/ResolvedSourceAudio"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "video"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "sourceStartFrame": {}
            },
            "required": [
              "sourceStartFrame"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "sourceStartFrame": {}
                  },
                  "required": [
                    "sourceStartFrame"
                  ]
                },
                {
                  "properties": {
                    "sourceAudio": {}
                  },
                  "required": [
                    "sourceAudio"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "ResolvedVisualSource": {
      "oneOf": [
        {
          "$ref": "timeline-manifest-v1.schema.json#/$defs/VideoSource"
        },
        {
          "$ref": "timeline-manifest-v1.schema.json#/$defs/StillSource"
        }
      ]
    },
    "ResolvedSourceAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sourceStartFrame"
      ],
      "properties": {
        "source": {
          "$ref": "timeline-manifest-v1.schema.json#/$defs/AudioSource"
        },
        "sourceStartFrame": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
