{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vera.video/contracts/authoring-project-settings-v1.schema.json",
  "title": "AuthoringProjectSettingsV1",
  "description": "Narrow project-level authoring defaults with immutable presenter-still identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "version",
    "settingsHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "authoring-project-settings/v1"
    },
    "id": {
      "$ref": "#/$defs/EntityId"
    },
    "projectId": {
      "$ref": "#/$defs/EntityId"
    },
    "version": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "settingsHash": {
      "$ref": "#/$defs/ContentHash"
    },
    "presenterStill": {
      "$ref": "#/$defs/PresenterStillReference"
    },
    "visualOnlyStillDurationMs": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "imageMotionDefault": {
      "$ref": "#/$defs/ImageMotionV1",
      "description": "Configured automatic image motion for new builds; older settings without this field retain legacy still behavior."
    }
  },
  "$defs": {
    "EntityId": {
      "type": "string",
      "format": "uuid"
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "NonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ImageMotionFrameV1": {
      "description": "Source-normalized focus and scale relative to authored framing; safe native delivery limits are qualified separately.",
      "type": "object",
      "additionalProperties": false,
      "required": ["focusX", "focusY", "scale"],
      "properties": {
        "focusX": { "type": "number", "minimum": 0, "maximum": 1 },
        "focusY": { "type": "number", "minimum": 0, "maximum": 1 },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "ImageMotionV1": {
      "description": "Frozen configured motion intent; no numeric zoom preset is implied.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "start", "end", "easing"],
          "properties": {
            "mode": { "const": "native_dynamic_zoom" },
            "start": { "$ref": "#/$defs/ImageMotionFrameV1" },
            "end": { "$ref": "#/$defs/ImageMotionFrameV1" },
            "easing": { "enum": ["linear", "ease_in", "ease_out", "ease_in_out"] }
          }
        }
      ]
    },
    "ProjectRelativePath": {
      "description": "Canonical slash-separated project-relative locator; absolute paths and dot segments are not accepted.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\\\r\\n]+$"
    },
    "PresenterStillReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaReferenceId",
        "artifactId",
        "artifactVersion",
        "contentHash",
        "projectRelativeLocator",
        "width",
        "height",
        "provenance"
      ],
      "properties": {
        "mediaReferenceId": {
          "$ref": "#/$defs/EntityId"
        },
        "artifactId": {
          "$ref": "#/$defs/EntityId"
        },
        "artifactVersion": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "contentHash": {
          "$ref": "#/$defs/ContentHash"
        },
        "projectRelativeLocator": {
          "$ref": "#/$defs/ProjectRelativePath"
        },
        "width": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "height": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "#/$defs/LocalImportProvenance"
            },
            {
              "$ref": "#/$defs/CapturedFrameProvenance"
            }
          ]
        }
      }
    },
    "LocalImportProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "originalFilename"
      ],
      "properties": {
        "origin": {
          "const": "local_import"
        },
        "originalFilename": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CapturedFrameProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "sourceMediaReferenceId",
        "sourceFrame"
      ],
      "properties": {
        "origin": {
          "const": "captured_frame"
        },
        "sourceMediaReferenceId": {
          "$ref": "#/$defs/EntityId"
        },
        "sourceFrame": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        }
      }
    }
  }
}
