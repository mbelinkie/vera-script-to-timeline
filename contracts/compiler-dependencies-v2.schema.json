        "artifactLocator": {
          "type": "string",
          "format": "uri-reference",
          "minLength": 1
        },
        "derivation": {
          "$ref": "#/$defs/PreparationDerivationV1"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "derived_cfr"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "derivation": true
            },
            "required": [
              "derivation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "verified_reuse"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "type": "object",
              "properties": {
                "derivation": true
              },
              "required": [
                "derivation"
              ]
            }
          }
        }
      ]
