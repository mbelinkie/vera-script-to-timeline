            "object_verification_unavailable"
          ]
        },
        "safeMessage": { "$ref": "#/$defs/BoundedText" },
        "retryable": { "type": "boolean" },
        "fieldPaths": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(?:|/(?:[A-Za-z0-9_~-]|~[01])*)$"
          }
        },
        "denialFingerprint": { "$ref": "#/$defs/KeyedFingerprint" }
      }
    }
