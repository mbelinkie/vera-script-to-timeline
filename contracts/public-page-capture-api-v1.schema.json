      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "messageType": { "type": "string", "const": "error" },
        "requestId": { "$ref": "#/$defs/EntityId" },
        "code": {
          "type": "string",
          "enum": [
            "request_invalid",
            "authentication_required",
            "action_not_allowed",
            "resource_not_found",
            "version_conflict",
            "idempotency_key_reused",
            "selection_conflict",
            "revision_requires_review",
            "job_not_committable",
