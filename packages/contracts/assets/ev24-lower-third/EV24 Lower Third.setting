				StyledText = Input { Expression = ": local c=math.floor(ControlHub.Country) local m=ControlHub.SongTitle.Value if m==\"\" then if c==53 then m=\"Matt Wrather\" else local t={[\"1956|Belgium\"]=\"Messieurs les noyés de la Seine\",[\"1956|France\"]=\"Il est là\",[\"1956|Germany\"]=\"So geht das jede Nacht\",[\"1956|Italy\"]=\"Aprite le finestre\",[\"1956|Luxembourg\"]=\"Les Amants de minuit\",[\"1956|Netherlands\"]=\"Voorgoed voorbij\",[\"1956|Switzerland\"]=\"Das alte Karussell\",[\"1957|Austria\"]=\"Wohin, kleines Pony?\",[\"1957|Belgium\"]=\"Straatdeuntje\",[\"1957|Denmark\"]=\"Skibet skal sejle i nat\",[\"1957|France\"]=\"La Belle Amour\",[\"1957|Germany\"]=\"Telefon, Telefon\",[\"1957|Italy\"]=\"Corde della mia chitarra\",[\"1957|Luxembourg\"]=\"Tant de peine\",[\"1957|Netherlands\"]=\"Net als toen\",[\"1957|Switzerland\"]=\"L'Enfant que j'étais\",[\"1957|United Kingdom\"]=\"All\",[\"1958|Austria\"]=\"Die ganze Welt braucht Liebe\",[\"1958|Belgium\"]=\"Ma petite chatte\",[\"1958|Denmark\"]=\"Jeg rev et blad ud af min dagbog\",[\"1958|France\"]=\"Dors mon amour\",[\"1958|Germany\"]=\"Für zwei Groschen Musik\",[\"1958|Italy\"]=\"Nel blu, dipinto di blu\",[\"1958|Luxembourg\"]=\"Un grand amour\",[\"1958|Netherlands\"]=\"Heel de wereld\",[\"1958|Sweden\"]=\"Lilla stjärna\",[\"1958|Switzerland\"]=\"Giorgio\",[\"1959|Austria\"]=\"Der K. und K. Kalypso aus Wien\",[\"1959|Belgium\"]=\"Hou toch van mij\",[\"1959|Denmark\"]=\"Uh, jeg ville ønske jeg var dig\",[\"1959|France\"]=\"Oui, oui, oui, oui\",[\"1959|Germany\"]=\"Heut' woll'n wir tanzen geh'n\",[\"1959|Italy\"]=\"Piove\",[\"1959|Monaco\"]=\"Mon ami Pierrot\",[\"1959|Netherlands\"]=\"Een beetje\",[\"1959|Sweden\"]=\"Augustin\",[\"1959|Switzerland\"]=\"Irgendwoher\",[\"1959|United Kingdom\"]=\"Sing Little Birdie\",[\"1960|Austria\"]=\"Du hast mich so fasziniert\",[\"1960|Belgium\"]=\"Mon amour pour toi\",[\"1960|Denmark\"]=\"Det var en yndig tid\",[\"1960|France\"]=\"Tom Pillibi\",[\"1960|Germany\"]=\"Bonne nuit m