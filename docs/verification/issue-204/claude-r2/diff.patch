+def launcher(release: Path, request: Path) -> subprocess.CompletedProcess[str]:
+    shutil.copyfile(request, release / RELEASE_NAME / "request.json")
+    return subprocess.run(
+        [sys.executable, "-S", str(release / LAUNCHER_NAME)],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+
